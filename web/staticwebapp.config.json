{
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "routes": [
    { "route": "/vendor/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/data/*", "headers": { "Cache-Control": "public, max-age=3600" } },
    { "route": "/css/*", "headers": { "Cache-Control": "public, max-age=3600" } },
    { "route": "/js/*", "headers": { "Cache-Control": "public, max-age=3600" } }
  ],
  "mimeTypes": {
    ".json": "application/json"
  }
}
